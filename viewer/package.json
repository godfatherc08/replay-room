{
  "name": "replay-room-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Replay Room 3D moment viewer (Babylon.js, static; loads bundles from python -m replay_room.render)",
  "scripts": {
    "export": "cd .. && python -m replay_room.render data/fixtures/synthetic_match_01",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
