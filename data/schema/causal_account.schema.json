{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "description": "An option that was actually available at the decision frame, valued from the real positions.",
      "properties": {
        "completion_prob": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Prob"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "event": "#/$defs/EventRef",
                "frame": "#/$defs/FrameRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EventRef"
              },
              {
                "$ref": "#/$defs/FrameRef"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "target_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Player Id"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "description",
        "value",
        "evidence"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Contribution": {
      "additionalProperties": false,
      "description": "One evidence-bound causal fact, kept because its effect cleared the threshold.\n\n``metrics`` holds the cited numbers, keyed by metric name: ``vaep``,\n``delta_xt``, ``xg``, ``space_created``, ``space_conceded``,\n``pitch_control_delta``, ...",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "contribution_id": {
          "title": "Contribution Id",
          "type": "string"
        },
        "effect": {
          "title": "Effect",
          "type": "number"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "event": "#/$defs/EventRef",
                "frame": "#/$defs/FrameRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EventRef"
              },
              {
                "$ref": "#/$defs/FrameRef"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "action_value",
            "space_creation",
            "space_conceded",
            "marking_break"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "player_id": {
          "title": "Player Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "role": {
          "enum": [
            "primary_cause",
            "finish",
            "assist",
            "build_up",
            "space_creation",
            "defensive_error"
          ],
          "title": "Role",
          "type": "string"
        },
        "shapley_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shapley Share"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "track": {
          "enum": [
            "on_ball",
            "off_ball"
          ],
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "contribution_id",
        "rank",
        "track",
        "kind",
        "role",
        "player_id",
        "team_id",
        "t",
        "effect",
        "evidence"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "Counterfactual": {
      "additionalProperties": false,
      "description": "'A better option existed'. Surfaced only when it beats the chosen action by the margin.",
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        },
        "chosen": {
          "title": "Chosen",
          "type": "string"
        },
        "chosen_value": {
          "title": "Chosen Value",
          "type": "number"
        },
        "contribution_id": {
          "title": "Contribution Id",
          "type": "string"
        },
        "decision_frame": {
          "$ref": "#/$defs/FrameRef"
        }
      },
      "required": [
        "contribution_id",
        "decision_frame",
        "chosen",
        "chosen_value",
        "alternatives"
      ],
      "title": "Counterfactual",
      "type": "object"
    },
    "EventRef": {
      "additionalProperties": false,
      "description": "Points at one on-ball SPADL action (``action_id`` is unique within a game).",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "event",
          "default": "event",
          "title": "Kind",
          "type": "string"
        },
        "original_event_id": {
          "title": "Original Event Id",
          "type": "string"
        },
        "period_id": {
          "title": "Period Id",
          "type": "integer"
        },
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "action_id",
        "original_event_id",
        "period_id",
        "time_seconds"
      ],
      "title": "EventRef",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "description": "Points at one tracking frame (``frame_id`` is unique within a game), optionally\nnaming the players that matter in it.",
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "integer"
        },
        "kind": {
          "const": "frame",
          "default": "frame",
          "title": "Kind",
          "type": "string"
        },
        "player_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Player Ids",
          "type": "array"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "number"
        }
      },
      "required": [
        "frame_id",
        "timestamp"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "Moment": {
      "additionalProperties": false,
      "properties": {
        "attacking_team_id": {
          "title": "Attacking Team Id",
          "type": "string"
        },
        "chain": {
          "items": {
            "$ref": "#/$defs/EventRef"
          },
          "minItems": 1,
          "title": "Chain",
          "type": "array"
        },
        "chain_start": {
          "enum": [
            "regain",
            "kickoff",
            "set_piece",
            "period_start",
            "truncated"
          ],
          "title": "Chain Start",
          "type": "string"
        },
        "contested_action_ids": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Contested Action Ids",
          "type": "array"
        },
        "defending_team_id": {
          "title": "Defending Team Id",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "is_own_goal": {
          "default": false,
          "title": "Is Own Goal",
          "type": "boolean"
        },
        "key_event_ref": {
          "$ref": "#/$defs/EventRef"
        },
        "key_player_id": {
          "title": "Key Player Id",
          "type": "string"
        },
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "period_id": {
          "title": "Period Id",
          "type": "integer"
        },
        "possession_id": {
          "title": "Possession Id",
          "type": "integer"
        },
        "t_end": {
          "title": "T End",
          "type": "number"
        },
        "t_event": {
          "title": "T Event",
          "type": "number"
        },
        "t_start": {
          "title": "T Start",
          "type": "number"
        },
        "turnover_event_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "goal",
          "title": "Type",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/TrackingWindow"
        }
      },
      "required": [
        "moment_id",
        "type",
        "game_id",
        "period_id",
        "t_event",
        "attacking_team_id",
        "defending_team_id",
        "key_event_ref",
        "key_player_id",
        "possession_id",
        "chain",
        "chain_start",
        "t_start",
        "t_end",
        "window"
      ],
      "title": "Moment",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "player_id": {
          "title": "Player Id",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "shirt_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shirt Number"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "name",
        "team_id"
      ],
      "title": "Participant",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "counterfactual_margin": {
          "title": "Counterfactual Margin",
          "type": "number"
        },
        "effect_threshold": {
          "title": "Effect Threshold",
          "type": "number"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "pipeline_version",
        "source",
        "effect_threshold",
        "counterfactual_margin",
        "generated_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TeamInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "name"
      ],
      "title": "TeamInfo",
      "type": "object"
    },
    "TrackingWindow": {
      "additionalProperties": false,
      "properties": {
        "frame_end": {
          "title": "Frame End",
          "type": "integer"
        },
        "frame_start": {
          "title": "Frame Start",
          "type": "integer"
        },
        "period_id": {
          "title": "Period Id",
          "type": "integer"
        },
        "t_end": {
          "title": "T End",
          "type": "number"
        },
        "t_start": {
          "title": "T Start",
          "type": "number"
        }
      },
      "required": [
        "period_id",
        "frame_start",
        "frame_end",
        "t_start",
        "t_end"
      ],
      "title": "TrackingWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "contributions": {
      "items": {
        "$ref": "#/$defs/Contribution"
      },
      "minItems": 1,
      "title": "Contributions",
      "type": "array"
    },
    "counterfactuals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Counterfactual"
      },
      "title": "Counterfactuals",
      "type": "array"
    },
    "game_id": {
      "title": "Game Id",
      "type": "string"
    },
    "headline_contribution_id": {
      "title": "Headline Contribution Id",
      "type": "string"
    },
    "moment": {
      "$ref": "#/$defs/Moment"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "minItems": 1,
      "title": "Participants",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "0.3",
      "default": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "teams": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/TeamInfo"
        },
        {
          "$ref": "#/$defs/TeamInfo"
        }
      ],
      "title": "Teams",
      "type": "array"
    }
  },
  "required": [
    "account_id",
    "game_id",
    "moment",
    "teams",
    "participants",
    "headline_contribution_id",
    "contributions",
    "provenance"
  ],
  "title": "CausalAccount",
  "type": "object"
}
