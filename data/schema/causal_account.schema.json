{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "description": "An option that was actually available at the decision frame, valued from the real positions.",
      "properties": {
        "completion_prob": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Prob"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "event": "#/$defs/EventRef",
                "frame": "#/$defs/FrameRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EventRef"
              },
              {
                "$ref": "#/$defs/FrameRef"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "target_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Player Id"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "description",
        "value",
        "evidence"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "ContextRef": {
      "additionalProperties": false,
      "description": "Points at one non-SPADL context event (``ContextEvent.event_id``), e.g. a\nsubstitution. Moment keys only: never evidence for a causal claim.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "const": "context",
          "default": "context",
          "title": "Kind",
          "type": "string"
        },
        "period_id": {
          "title": "Period Id",
          "type": "integer"
        },
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "event_id",
        "period_id",
        "time_seconds"
      ],
      "title": "ContextRef",
      "type": "object"
    },
    "Contribution": {
      "additionalProperties": false,
      "description": "One evidence-bound causal fact, kept because its effect cleared the threshold.\n\n``metrics`` holds the cited numbers, keyed by metric name: ``vaep``,\n``delta_xt``, ``xg``, ``space_created``, ``space_conceded``,\n``pitch_control_delta``, ...",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "contribution_id": {
          "title": "Contribution Id",
          "type": "string"
        },
        "effect": {
          "title": "Effect",
          "type": "number"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "event": "#/$defs/EventRef",
                "frame": "#/$defs/FrameRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EventRef"
              },
              {
                "$ref": "#/$defs/FrameRef"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "action_value",
            "space_creation",
            "space_conceded",
            "marking_break",
            "chance_denied"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "player_id": {
          "title": "Player Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "role": {
          "enum": [
            "primary_cause",
            "finish",
            "assist",
            "build_up",
            "space_creation",
            "attacking_error",
            "defensive_error",
            "defending",
            "prevention"
          ],
          "title": "Role",
          "type": "string"
        },
        "shapley_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shapley Share"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "track": {
          "enum": [
            "on_ball",
            "off_ball"
          ],
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "contribution_id",
        "rank",
        "track",
        "kind",
        "role",
        "player_id",
        "team_id",
        "t",
        "effect",
        "evidence"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "Counterfactual": {
      "additionalProperties": false,
      "description": "'A better option existed'. Surfaced only when it beats the chosen action by the margin.",
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        },
        "chosen": {
          "title": "Chosen",
          "type": "string"
        },
        "chosen_value": {
          "title": "Chosen Value",
          "type": "number"
        },
        "contribution_id": {
          "title": "Contribution Id",
          "type": "string"
        },
        "decision_frame": {
          "$ref": "#/$defs/FrameRef"
        }
      },
      "required": [
        "contribution_id",
        "decision_frame",
        "chosen",
        "chosen_value",
        "alternatives"
      ],
      "title": "Counterfactual",
      "type": "object"
    },
    "EventRef": {
      "additionalProperties": false,
      "description": "Points at one on-ball SPADL action (``action_id`` is unique within a game).",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "event",
          "default": "event",
          "title": "Kind",
          "type": "string"
        },
        "original_event_id": {
          "title": "Original Event Id",
          "type": "string"
        },
        "period_id": {
          "title": "Period Id",
          "type": "integer"
        },
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "action_id",
        "original_event_id",
        "period_id",
        "time_seconds"
      ],
      "title": "EventRef",
      "type": "object"
    },
    "EvidenceIndex": {
      "additionalProperties": false,
      "description": "Every record the account cites (the spec's ``evidence`` block), sorted.",
      "properties": {
        "events": {
          "items": {
            "type": "integer"
          },
          "title": "Events",
          "type": "array"
        },
        "frames": {
          "items": {
            "type": "integer"
          },
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "events",
        "frames"
      ],
      "title": "EvidenceIndex",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "description": "Points at one tracking frame (``frame_id`` is unique within a game), optionally\nnaming the players that matter in it.",
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "integer"
        },
        "kind": {
          "const": "frame",
          "default": "frame",
          "title": "Kind",
          "type": "string"
        },
        "player_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Player Ids",
          "type": "array"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "number"
        }
      },
      "required": [
        "frame_id",
        "timestamp"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A causal link behind a defensive flaw, measured on the tracking (never inferred).\n\nWho the defender was marking is the nearest-attacker assignment at the start\nof his fact's span; the runner is an attacker he moved with over that span;\n``zone`` names where the key event happened (the space his share was\nmeasured at); ``enabled`` is the first attacking action into that zone after\nthe span began. A link is emitted only when its geometric tests pass.",
      "properties": {
        "defender_contribution_id": {
          "title": "Defender Contribution Id",
          "type": "string"
        },
        "defender_id": {
          "title": "Defender Id",
          "type": "string"
        },
        "enabled": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled_contribution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled Contribution Id"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/FrameRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "decoy_run",
            "dragged_out",
            "run_past",
            "lost_man"
          ],
          "title": "Kind",
          "type": "string"
        },
        "link_id": {
          "title": "Link Id",
          "type": "string"
        },
        "marked_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marked Player Id"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "runner_contribution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Contribution Id"
        },
        "runner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Id"
        },
        "zone": {
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "link_id",
        "kind",
        "defender_contribution_id",
        "defender_id",
        "zone",
        "evidence"
      ],
      "title": "Link",
      "type": "object"
    },
